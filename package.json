{
  "name": "texas-holdem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:server",
    "preview": "vite preview",
    "build:server": "esbuild server/index.ts server/backup.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-server",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.js",
    "backup": "node dist-server/backup.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  }
}

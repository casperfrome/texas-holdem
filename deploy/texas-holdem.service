[Unit]
Description=Texas Holdem authoritative game server
After=network.target

[Service]
Type=simple
User=texas-holdem
Group=texas-holdem
WorkingDirectory=/opt/texas-holdem/current
EnvironmentFile=/etc/texas-holdem.env
ExecStart=/usr/local/bin/node /opt/texas-holdem/current/dist-server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/texas-holdem
UMask=0077

[Install]
WantedBy=multi-user.target
